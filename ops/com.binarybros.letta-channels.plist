<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Letta Slack channels daemon — node bridge that relays the Letta
  channels API into Slack. It silently stayed unloaded for 10 days
  because nothing installed or supervised it; Andromeda fleet now
  owns install + health probe (`andromeda fleet install` / `status`).

  KeepAlive=true: the daemon is infrastructure — a crash restarts it,
  same contract as com.andromeda.mcp-hub.plist (nobody "quits" it by
  hand; Slack visibility must survive restarts).

  IMPORTANT: Exec node directly under launchd. Do NOT use
  /usr/bin/open -a — LaunchServices `open` can inherit Aqua/agent-shell
  env. Same contract as com.andromeda.hud / mcp-hub plists.

  Path template: launchd does NOT expand $HOME/~ — install must rewrite
  the Studio home string to the real $HOME (absolute paths only).
  Swift installer contract (BIN-101): same rewrite, no bash.

  Install (typed Swift, fleet lane):
    andromeda fleet install \
      --destination ~/Library/LaunchAgents/com.binarybros.letta-channels.plist
  Health probe:
    andromeda fleet status
  Unload:
    launchctl bootout gui/$(id -u)/com.binarybros.letta-channels
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.binarybros.letta-channels</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/node</string>
		<string>/Users/admin/.local/bin/LettaChannels</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/admin</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>StandardOutPath</key>
	<string>/Users/admin/.letta/logs/letta-channels.out.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/admin/.letta/logs/letta-channels.err.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/admin</string>
	</dict>
</dict>
</plist>
